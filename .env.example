# Copy this file to .env and fill in your values
# DO NOT commit .env to version control
# Market data and NAV come from AKShare and need no account.

# v2 pipeline LLM (src/pipeline/llm.py): any OpenAI-compatible endpoint
LOF_LLM_BASE_URL=http://127.0.0.1:3425/v1
LOF_LLM_API_KEY=your_gateway_key
LOF_LLM_MODEL=workbuddy/glm-5.3-flash
# LOF_LLM_REASONING=low   # low / medium / high, sent as reasoning_effort
# LOF_LLM_TIMEOUT=120
# LOF_LLM_MAX_RETRIES=4
